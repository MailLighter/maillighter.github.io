---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { siteConfig } from '@/config';
---

<MarketingLayout
  title={`Gracias — ${siteConfig.name} Enterprise`}
  description="Su carta de intenciones ha sido recibida. Le responderemos en un plazo de 5 días hábiles."
>
  <section class="ty-section">
    <div class="ty-inner">
      <div class="ty-checkmark" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <span class="ty-eyebrow"><span class="eyebrow-base">Enterprise</span><span class="eyebrow-accent">Intención recibida</span></span>
      <h1 class="ty-title"><span class="ml-gradient-text">Gracias.</span></h1>
      <p class="ty-sub">Su carta de intenciones ha sido recibida. Le responderemos en un plazo de 5 días hábiles.</p>
      <p class="ty-text">Mientras tanto, puede leer nuestra <a href="/es/methodology">metodología pública</a> o saber más sobre nuestra <a href="/es/">versión gratuita</a>.</p>
      <div class="ty-ctas">
        <a href="/es/" class="btn-ghost">← Volver al inicio</a>
        <a href="/es/methodology" class="btn-primary">Leer la metodología →</a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes scaleIn { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: scale(1); } }

  .ty-section { position: relative; padding: 140px 52px 100px; text-align: center; overflow: hidden; }
  .ty-section::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(74,162,81,0.14), transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 30%, rgba(21,100,192,0.06), transparent 60%);
  }
  :global(.dark) .ty-section::before {
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(74,162,81,0.20), transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 30%, rgba(21,100,192,0.14), transparent 60%);
  }
  .ty-inner { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }

  .ty-checkmark {
    width: 56px; height: 56px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ml-green-pale); color: var(--ml-green-dark);
    border: 1.5px solid var(--ml-green);
    margin: 0 auto 20px;
    box-shadow: 0 6px 20px rgba(74,162,81,0.25);
    animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  :global(.dark) .ty-checkmark { color: var(--ml-green); }

  .ty-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--ml-green-pale); color: var(--ml-green-dark);
    font-size: 0.72rem; font-weight: 700; padding: 4px 6px 4px 12px; border-radius: 999px;
    letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 18px;
    animation: fadeUp 0.6s ease-out 0.15s both;
  }
  :global(.dark) .ty-eyebrow { color: var(--ml-green); }
  .ty-eyebrow .eyebrow-base { padding-right: 4px; }
  .ty-eyebrow .eyebrow-accent {
    display: inline-flex; align-items: center;
    background: rgba(255,255,255,0.55); color: var(--ml-green-dark);
    padding: 3px 10px; border-radius: 999px; font-size: 0.68rem;
  }
  :global(.dark) .ty-eyebrow .eyebrow-accent { background: rgba(74,162,81,0.18); color: var(--ml-green); }

  .ty-title { font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 800; line-height: 1.15; margin-bottom: 16px; color: var(--ml-ink); animation: fadeUp 0.6s ease-out 0.25s both; }
  .ty-sub { font-size: 1.1rem; color: var(--ml-ink); line-height: 1.7; margin-bottom: 14px; animation: fadeUp 0.6s ease-out 0.35s both; }
  .ty-text { font-size: 0.95rem; color: var(--ml-ink-soft); line-height: 1.75; margin-bottom: 32px; animation: fadeUp 0.6s ease-out 0.45s both; }
  .ty-text a { color: var(--ml-blue); text-decoration: underline; font-weight: 500; }
  .ty-ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; animation: fadeUp 0.6s ease-out 0.55s both; }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ml-blue); color: white;
    padding: 13px 26px; border-radius: 8px; font-weight: 600; font-size: 0.95rem;
    text-decoration: none; box-shadow: 0 4px 16px rgba(21,100,192,0.3);
  }
  .btn-primary:hover { background: var(--ml-blue-dark); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--ml-ink-soft); font-weight: 500; font-size: 0.9rem;
    text-decoration: none; border: 1px solid var(--color-border);
    padding: 12px 22px; border-radius: 8px; background: var(--color-surface);
  }
  .btn-ghost:hover { border-color: var(--ml-blue); color: var(--ml-blue); }

  @media (max-width: 640px) {
    .ty-section { padding: 100px 20px 60px; }
  }
</style>
