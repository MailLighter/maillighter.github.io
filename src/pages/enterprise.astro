---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { siteConfig } from '@/config';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY_ENTERPRISE || '';
---

<MarketingLayout
  title={`${siteConfig.name} Enterprise — CSRD-ready email carbon reporting (Coming Q4 2026)`}
  description="MailLighter Enterprise aggregates email carbon savings for CSRD reporting. Methodology validated by independent third-party. Coming Q4 2026."
>
  <!-- HERO -->
  <section class="ent-hero">
    <div class="ent-hero-inner">
      <span class="ent-eyebrow"><span class="eyebrow-base">Enterprise</span><span class="eyebrow-accent">Coming Q4 2026</span></span>
      <h1 class="ent-title">MailLighter Enterprise — <span class="ml-gradient-text">measure, report, comply.</span></h1>
      <p class="ent-sub">Aggregate the carbon savings achieved across your entire organization with MailLighter. Generate a CSRD-ready report. Methodology validated by independent third-party.</p>
      <div class="ent-ctas">
        <a href="#intent-form" class="btn-primary">Request early access →</a>
        <a href="/methodology" class="btn-ghost">Read the methodology</a>
      </div>
    </div>
  </section>

  <!-- TRANSPARENCY BANNER -->
  <section class="ent-banner-wrap">
    <div class="ent-banner">
      <strong>Currently in design — public launch planned for Q4 2026.</strong>
      <p>We're collecting feedback from organizations interested in MailLighter Enterprise to make sure we build exactly what you need. No commercial commitment required at this stage.</p>
    </div>
  </section>

  <!-- VALUE BLOCKS -->
  <section class="ent-section">
    <div class="ent-section-inner">
      <h2 class="ent-h2">What MailLighter Enterprise will deliver</h2>
      <div class="ent-cards-3">
        <div class="ent-card">
          <div class="ent-card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg></div>
          <h3>Centralized dashboard</h3>
          <p>Real-time view of your organization's email-related carbon savings. Breakdown by category (images, attachments, replies). Multi-year trend.</p>
        </div>
        <div class="ent-card">
          <div class="ent-card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 14 11 16 15 12"/></svg></div>
          <h3>CSRD-ready report</h3>
          <p>Annual PDF report extractable in one click. Pre-formatted text block compatible with the ESRS E1 section of your sustainability report.</p>
        </div>
        <div class="ent-card">
          <div class="ent-card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
          <h3>Public methodology</h3>
          <p>Carbon calculation methodology aligned with GHG Protocol, ADEME Base Empreinte 2025 and ESRS E1. Versioned, public, and peer-reviewed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="ent-section ent-section-alt">
    <div class="ent-section-inner">
      <h2 class="ent-h2">Indicative pricing — subject to change</h2>
      <div class="ent-pricing">
        <div class="ent-price-card">
          <div class="ent-price-name">Community</div>
          <div class="ent-price-size">&lt; 50 employees</div>
          <div class="ent-price-amount">Free forever</div>
        </div>
        <div class="ent-price-card">
          <div class="ent-price-name">Starter</div>
          <div class="ent-price-size">51–250 employees</div>
          <div class="ent-price-amount">~ €290 / year</div>
        </div>
        <div class="ent-price-card">
          <div class="ent-price-name">Business</div>
          <div class="ent-price-size">251–1,000 employees</div>
          <div class="ent-price-amount">~ €690 / year</div>
        </div>
        <div class="ent-price-card">
          <div class="ent-price-name">Corporate</div>
          <div class="ent-price-size">1,001–5,000 employees</div>
          <div class="ent-price-amount">~ €1,490 / year</div>
        </div>
        <div class="ent-price-card">
          <div class="ent-price-name">Enterprise</div>
          <div class="ent-price-size">5,001–20,000 employees</div>
          <div class="ent-price-amount">~ €2,990 / year</div>
        </div>
        <div class="ent-price-card">
          <div class="ent-price-name">Cap</div>
          <div class="ent-price-size">&gt; 20,000 employees</div>
          <div class="ent-price-amount">~ €4,490 / year</div>
        </div>
      </div>
      <p class="ent-pricing-note">Full pricing grid with all tiers will be published at launch. Non-profits and associations of all sizes will benefit from the free Community tier.</p>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="ent-section">
    <div class="ent-section-inner">
      <h2 class="ent-h2">Privacy &amp; data principles</h2>
      <ul class="ent-list">
        <li><strong>No email content ever transmitted.</strong> Just as with the free version, the body, subject, recipients, attachments stay on the user's device.</li>
        <li><strong>Anonymized organization identifier.</strong> A SHA-256 hash of your Microsoft 365 tenant ID, irreversible.</li>
        <li><strong>5 metrics transmitted per cleanup, that's it.</strong> Bytes removed, element type, recipient count, UTC timestamp, hashed tenant ID. Nothing else.</li>
        <li><strong>Counted only when the email is actually sent.</strong> A cleanup followed by an abandonment (compose window closed, restored draft) is never counted as a saving. No data is sent to the backend until the user clicks "Send".</li>
        <li><strong>EU-only hosting.</strong> No transfer outside the European Union.</li>
      </ul>
    </div>
  </section>

  <!-- VALIDATION -->
  <section class="ent-section ent-section-alt">
    <div class="ent-section-inner ent-validation">
      <h2 class="ent-h2">Validation &amp; partnerships</h2>
      <p><strong>Methodology under review by an independent third party (Q2 2026).</strong></p>
      <p>Following peer review, the methodology will be submitted for ISO 14064-2 alignment and published openly. Pricing partnership with Microsoft Marketplace ensures simplified procurement for IT departments. A reseller program will be available for consulting firms specializing in sustainability and Microsoft 365 integrators.</p>
    </div>
  </section>

  <!-- FORM -->
  <section class="ent-section" id="intent-form">
    <div class="ent-form-wrap">
      <div class="ent-form-head">
        <h2 class="ent-h2">Help us build the right product</h2>
        <p>Tell us about your organization and what you'd expect from MailLighter Enterprise. We'll get back to you within 5 business days. By signing up, you secure preferential pricing for the first 12 months following launch.</p>
      </div>

      <form
        id="intent-form-el"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="ent-form"
        data-has-access-key={accessKey ? 'true' : 'false'}
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="from_name" value="MailLighter Enterprise — Intent Letter" />
        <input type="hidden" name="subject" value="New Enterprise intent letter" />
        <input type="hidden" name="redirect" value="https://maillighter.com/enterprise/thank-you" />
        <div class="hidden" aria-hidden="true">
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
        </div>

        <div class="ent-form-grid">
          <label>First name *<input type="text" name="firstName" required minlength="2" placeholder="Sophie" /></label>
          <label>Last name *<input type="text" name="lastName" required minlength="2" placeholder="Martin" /></label>
          <label class="full">Email *<input type="email" name="email" required placeholder="sophie.martin@company.com" /></label>
          <label class="full">Organization name *<input type="text" name="organization" required minlength="2" placeholder="Acme Corp" /></label>
          <label>Your role *
            <select name="role" required>
              <option value="">— Select —</option>
              <option>CSR Officer</option>
              <option>IT Director</option>
              <option>Sustainability Manager</option>
              <option>Procurement</option>
              <option>Founder / CEO</option>
              <option>Other</option>
            </select>
          </label>
          <label>Organization size *
            <select name="size" required>
              <option value="">— Select —</option>
              <option>&lt; 50</option>
              <option>50–250</option>
              <option>251–1,000</option>
              <option>1,001–5,000</option>
              <option>5,001–20,000</option>
              <option>20,000+</option>
            </select>
          </label>
          <label class="full">Country *
            <select name="country" required>
              <option value="">— Select —</option>
              <optgroup label="European Union">
                <option>Austria</option><option>Belgium</option><option>Bulgaria</option>
                <option>Croatia</option><option>Cyprus</option><option>Czech Republic</option>
                <option>Denmark</option><option>Estonia</option><option>Finland</option>
                <option>France</option><option>Germany</option><option>Greece</option>
                <option>Hungary</option><option>Ireland</option><option>Italy</option>
                <option>Latvia</option><option>Lithuania</option><option>Luxembourg</option>
                <option>Malta</option><option>Netherlands</option><option>Poland</option>
                <option>Portugal</option><option>Romania</option><option>Slovakia</option>
                <option>Slovenia</option><option>Spain</option><option>Sweden</option>
              </optgroup>
              <option>Other</option>
            </select>
          </label>
        </div>

        <fieldset class="ent-fieldset">
          <legend>What is your CSRD context? *</legend>
          <label class="ent-radio"><input type="radio" name="csrdContext" value="subject" required /> We are subject to CSRD obligations</label>
          <label class="ent-radio"><input type="radio" name="csrdContext" value="upcoming" /> We will be subject in the next 2 years</label>
          <label class="ent-radio"><input type="radio" name="csrdContext" value="voluntary" /> We voluntarily produce sustainability reports</label>
          <label class="ent-radio"><input type="radio" name="csrdContext" value="none" /> We don't produce sustainability reports today</label>
        </fieldset>

        <fieldset class="ent-fieldset">
          <legend>Which features matter most to you?</legend>
          <label class="ent-check"><input type="checkbox" name="features" value="csrd-pdf" /> CSRD-ready PDF report</label>
          <label class="ent-check"><input type="checkbox" name="features" value="dashboard" /> Real-time dashboard</label>
          <label class="ent-check"><input type="checkbox" name="features" value="multi-year" /> Multi-year history</label>
          <label class="ent-check"><input type="checkbox" name="features" value="department" /> Per-department breakdown</label>
          <label class="ent-check"><input type="checkbox" name="features" value="api" /> API export</label>
          <label class="ent-check"><input type="checkbox" name="features" value="reseller" /> Reseller branding</label>
        </fieldset>

        <label class="full">Tell us more
          <textarea name="message" rows="4" placeholder="Optional"></textarea>
        </label>

        <label class="ent-consent">
          <input type="checkbox" name="consent" required />
          I agree to be contacted about MailLighter Enterprise (we will not share your contact information with third parties).
        </label>

        <button type="submit" class="btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Send
        </button>
      </form>
    </div>
  </section>

  <!-- TRANSPARENCY CLOSE -->
  <section class="ent-section ent-section-alt">
    <div class="ent-section-inner ent-closing">
      <h2 class="ent-h2">Why "Coming Soon" rather than "Buy now"?</h2>
      <p>Because we'd rather build with our users than sell them something half-finished. Your intent letter helps us prioritize features, scope the methodology, and time the launch right. You'll hear from us — without spam, without sales pressure.</p>
    </div>
  </section>
</MarketingLayout>

<style>
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

  .ent-hero { position: relative; padding: 100px 52px 40px; text-align: center; overflow: hidden; }
  .ent-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background:
      radial-gradient(ellipse 60% 50% at 30% 0%, rgba(21,100,192,0.10), transparent 60%),
      radial-gradient(ellipse 50% 50% at 80% 20%, rgba(74,162,81,0.08), transparent 60%);
  }
  :global(.dark) .ent-hero::before {
    background:
      radial-gradient(ellipse 60% 50% at 30% 0%, rgba(21,100,192,0.18), transparent 60%),
      radial-gradient(ellipse 50% 50% at 80% 20%, rgba(74,162,81,0.14), transparent 60%);
  }
  .ent-hero-inner { position: relative; z-index: 1; max-width: 820px; margin: 0 auto; }
  .ent-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--ml-blue-pale); color: var(--ml-blue);
    font-size: 0.72rem; font-weight: 700; padding: 4px 6px 4px 12px; border-radius: 999px;
    letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 16px;
    animation: fadeUp 0.6s ease-out both;
  }
  .ent-eyebrow .eyebrow-base { padding-right: 4px; }
  .ent-eyebrow .eyebrow-accent {
    display: inline-flex; align-items: center;
    background: var(--ml-green-pale); color: var(--ml-green-dark);
    padding: 3px 10px; border-radius: 999px; font-size: 0.68rem;
  }
  :global(.dark) .ent-eyebrow .eyebrow-accent { color: var(--ml-green); }
  .ent-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 800; line-height: 1.15; margin-bottom: 16px; color: var(--ml-ink);
    animation: fadeUp 0.6s ease-out 0.1s both;
  }
  .ent-sub { font-size: 1.05rem; color: var(--ml-ink-soft); line-height: 1.75; max-width: 640px; margin: 0 auto 28px; animation: fadeUp 0.6s ease-out 0.2s both; }
  .ent-ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; animation: fadeUp 0.6s ease-out 0.3s both; }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ml-blue); color: white;
    padding: 13px 26px; border-radius: 8px; font-weight: 600; font-size: 0.95rem;
    text-decoration: none; box-shadow: 0 4px 16px rgba(21,100,192,0.3);
    transition: background 0.22s, transform 0.22s, box-shadow 0.22s;
    border: 0; cursor: pointer;
  }
  .btn-primary:hover { background: var(--ml-blue-dark); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(21,100,192,0.35); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--ml-ink-soft); font-weight: 500; font-size: 0.9rem;
    text-decoration: none; border: 1px solid var(--color-border);
    padding: 12px 22px; border-radius: 8px; background: var(--color-surface);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--ml-blue); color: var(--ml-blue); }

  .ent-banner-wrap { padding: 8px 52px 24px; }
  .ent-banner {
    max-width: 820px; margin: 0 auto;
    background: var(--ml-blue-pale); border: 1px solid var(--ml-blue-light);
    border-radius: 12px; padding: 20px 24px;
    font-size: 0.92rem; color: var(--ml-ink-soft); line-height: 1.65;
  }
  .ent-banner strong { color: var(--ml-ink); display: block; margin-bottom: 6px; }
  .ent-banner p { margin: 0; }
  :global(.dark) .ent-banner { background: rgba(21,100,192,0.1); }

  .ent-section { padding: 64px 52px; }
  .ent-section-alt { background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .ent-section-inner { max-width: 1000px; margin: 0 auto; }
  .ent-h2 {
    position: relative;
    font-size: clamp(1.6rem, 2.2vw, 2rem); font-weight: 800;
    color: var(--ml-ink); margin-bottom: 24px;
  }

  .ent-cards-3 {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  }
  .ent-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 14px; padding: 26px 22px;
    box-shadow: 0 4px 20px var(--ml-shadow);
    transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s;
  }
  .ent-card:hover { transform: translateY(-4px); border-color: var(--ml-blue-light); box-shadow: 0 12px 32px var(--ml-shadow); }
  .ent-card-icon {
    width: 42px; height: 42px; border-radius: 10px;
    background: rgba(21,100,192,0.12); color: var(--ml-blue);
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
  }
  :global(.dark) .ent-card-icon { background: rgba(21,100,192,0.25); color: #7ab2ee; }
  .ent-card h3 { font-size: 1.05rem; font-weight: 700; color: var(--ml-ink); margin-bottom: 8px; }
  .ent-card p { font-size: 0.9rem; color: var(--ml-ink-soft); line-height: 1.65; margin: 0; }
  :global(.dark) .ent-section-alt .ent-card { background: var(--color-bg); }

  .ent-pricing { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ent-price-card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: 12px; padding: 18px 20px;
    transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s;
  }
  .ent-price-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px var(--ml-shadow); border-color: var(--ml-blue-light); }
  .ent-price-featured { border-color: var(--ml-blue); box-shadow: 0 4px 18px rgba(21,100,192,0.18); }
  .ent-price-name { font-size: 0.95rem; font-weight: 700; color: var(--ml-ink); }
  .ent-price-size { font-size: 0.78rem; color: var(--ml-ink-mute); margin: 4px 0 10px; }
  .ent-price-amount { font-size: 1rem; font-weight: 700; color: var(--ml-blue); }
  .ent-pricing-note { font-size: 0.85rem; color: var(--ml-ink-mute); margin-top: 18px; font-style: italic; }

  .ent-list { list-style: none; padding: 0; margin: 0; }
  .ent-list li {
    position: relative; padding-left: 24px; font-size: 0.92rem;
    color: var(--ml-ink-soft); line-height: 1.75; margin-bottom: 12px;
  }
  .ent-list li::before {
    content: ''; position: absolute; left: 0; top: 10px;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--ml-blue); opacity: 0.5;
  }
  .ent-list strong { color: var(--ml-ink); }

  .ent-validation p, .ent-closing p {
    font-size: 0.95rem; color: var(--ml-ink-soft); line-height: 1.75; margin-bottom: 12px;
  }

  .ent-form-wrap {
    max-width: 800px; margin: 0 auto;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 20px; padding: 36px;
    box-shadow: 0 8px 40px var(--ml-shadow);
    transition: box-shadow 0.25s;
  }
  .ent-form-wrap:hover { box-shadow: 0 14px 56px var(--ml-shadow); }
  .ent-form-head { margin-bottom: 28px; }
  .ent-form-head p { font-size: 0.92rem; color: var(--ml-ink-soft); line-height: 1.7; margin-top: 8px; }

  .ent-form { display: flex; flex-direction: column; gap: 18px; }
  .ent-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .ent-form-grid label, .ent-form .full { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; color: var(--ml-ink); font-weight: 500; }
  .ent-form-grid label.full, .ent-form > label.full { grid-column: 1 / -1; }
  .ent-form input[type="text"], .ent-form input[type="email"], .ent-form select, .ent-form textarea {
    width: 100%; padding: 10px 12px; border: 1px solid var(--color-border);
    border-radius: 8px; background: white; color: var(--ml-ink);
    font-size: 0.92rem; font-family: inherit;
  }
  :global(.dark) .ent-form input[type="text"],
  :global(.dark) .ent-form input[type="email"],
  :global(.dark) .ent-form select,
  :global(.dark) .ent-form textarea { background: var(--color-bg); }
  .ent-form input::placeholder, .ent-form textarea::placeholder { color: #b0b8c5; }
  .ent-form textarea { resize: vertical; }
  .ent-form input:focus, .ent-form select:focus, .ent-form textarea:focus {
    outline: none; border-color: var(--ml-blue); box-shadow: 0 0 0 3px rgba(21,100,192,0.15);
  }
  .ent-form .btn-primary { width: 100%; justify-content: center; }

  .ent-fieldset { border: 1px solid var(--color-border); border-radius: 16px; padding: 14px 18px; margin: 0; }
  .ent-fieldset legend { font-size: 0.85rem; font-weight: 600; color: var(--ml-ink); padding: 0 6px; }
  .ent-radio, .ent-check {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 0; font-size: 0.9rem; color: var(--ml-ink-soft); cursor: pointer;
  }
  .ent-consent {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.85rem; color: var(--ml-ink-soft); line-height: 1.55;
  }
  .ent-consent input { margin-top: 3px; }
  .hidden { display: none; }

  @media (max-width: 768px) {
    .ent-hero { padding: 80px 20px 32px; }
    .ent-banner-wrap, .ent-section { padding-left: 20px; padding-right: 20px; }
    .ent-cards-3 { grid-template-columns: 1fr; }
    .ent-pricing { grid-template-columns: 1fr 1fr; }
    .ent-form-grid { grid-template-columns: 1fr; }
    .ent-form-wrap { padding: 24px; }
  }
  @media (max-width: 480px) {
    .ent-pricing { grid-template-columns: 1fr; }
  }
</style>
